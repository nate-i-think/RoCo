	(text "ST is an open drain output.\n\nWhen V_{OUT} = V_{IN1}:\nST is pulled high by the\nexternal source.\n\nWhen V_{OUT} = V_{IN2},\nor both chanels are disabled:\nST is pulled low by an\ninternal driver."
		(exclude_from_sim no)
		(at 217.932 181.61 0)
		(effects
			(font
				(size 0.762 0.762)
				(thickness 0.1111)
