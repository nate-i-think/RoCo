	(text "C_{1} = 1/((F_{S} * 2π)² * L_{S}')\nC_{2} = 1/((F_{D} * 2π)² * L_{S} - (1 / C_{1}))\nAssuming L_{S}' = 1.45 * L_{S}:\nC_{1} = ~150nF\nC_{2} = ~2.2nF"
		(exclude_from_sim no)
		(at 136.652 253.492 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left)
		)
		(uuid "2ed5641c-0eed-4570-8bdf-458ea5254d7d")
	)
	(text "COMM1 and COMM2 are currently\nset for 33nF_25V, but this can\nbe increased up to 47nF to\nincrease signal robustness or\ndecreased down to 22nF to \nincrease efficiency."
		(exclude_from_sim no)
		(at 125.73 213.36 0)
